# Salin menjadi .env (JANGAN di-commit). Baris TIDAK boleh diawali spasi.
# Ambil dari Supabase > tombol Connect > "Transaction pooler" (port 6543, wajib untuk Vercel).
# Username HARUS: app_server.<PROJECT-REF>   (project-ref = bagian depan URL proyek: https://<PROJECT-REF>.supabase.co)
# Password = password role app_server yang Anda tulis di supabase.sql (bukan password akun/dashboard Supabase).
DATABASE_URL=postgresql://app_server.PROJECTREF:PASSWORD_APP_SERVER@HOST_POOLER_DARI_DASHBOARD:6543/postgres

# Acak, minimal 32 karakter:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=isi-dengan-hasil-perintah-randomBytes-min-32-karakter

# Hanya dipakai oleh: npm run seed
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-minimal-10-karakter
ADMIN_PIN=123456
